# Copy this file to .env. All credential values below are public examples for
# local development only; replace them with private values before deployment.
# Conversion jobs use PostgreSQL; no Redis or separate queue service is needed.
NODE_ENV=development
API_PORT=4000
TRUST_PROXY_HOPS=0
WEB_ORIGIN=http://localhost:3000

# Local development PostgreSQL connection; replace credentials for your setup.
DATABASE_URL=postgresql://postgres:password@localhost:5432/design_to_elementor

# Local-only example. Generate a unique random secret for any real deployment.
JWT_SECRET=local-only-change-this-secret-before-deploying-123456

# Upload limits (bytes): 500 MiB per file (524288000) and 2 GiB per project (2147483648) by default.
UPLOAD_MAX_BYTES=524288000
UPLOAD_QUOTA_BYTES=2147483648

# ZIP archive safety limits.
ZIP_MAX_ENTRIES=10000
ZIP_MAX_UNCOMPRESSED_BYTES=1073741824
ZIP_MAX_ENTRY_BYTES=67108864
ZIP_MAX_COMPRESSION_RATIO=200

# Object storage configuration: Backblaze B2 (S3-compatible API).
# Production requires STORAGE_PROVIDER=b2.
# Local development and offline unit tests may explicitly select STORAGE_PROVIDER=local.
STORAGE_PROVIDER=b2

B2_BUCKET_NAME=design-to-elementor-storage
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_APPLICATION_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_PRESIGNED_TTL_SECONDS=900

# Local-only private filesystem storage adapter (used only when STORAGE_PROVIDER=local).
LOCAL_STORAGE_PATH=./storage/uploads

# AI provider configuration (OpenAI-compatible endpoint such as groq or openai).
AI_PROVIDER=disabled
AI_API_KEY=not-used-while-disabled
AI_MODEL=not-used-while-disabled

# Local-only 32-byte example key. Generate a private stable key before enabling
# WordPress site credentials or using this outside local development.
SITE_CREDENTIAL_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=

# PostgreSQL worker settings.
CONVERSION_WORKER_CONCURRENCY=2
CONVERSION_MAX_ATTEMPTS=3